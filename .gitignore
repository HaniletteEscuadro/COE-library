# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploaded library files (kept outside /public so they are never served
# without an auth check)
/storage/

# local SQLite database + its WAL/journal sidecars.
#
# Matched anywhere in the tree, not just under /prisma/. The runtime resolves
# `file:./dev.db` relative to the *process* working directory, so the real
# database lands at the project root — a `/prisma/*.db` rule alone left it
# tracked, and committing it publishes every account's email address and bcrypt
# hash along with every uploaded file's metadata.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Manual backups taken before risky migrations. These are a full copy of the
# database *and* the uploads directory, so they must never be committed either.
/backup-*/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# NOTE: `/portal/` is deliberately NOT ignored.
#
# It is generated by `scripts/bundle-portal.mjs`, but it has to be committed:
# deployment only receives this directory, so a gitignored copy would never
# reach the host and every /portal/* request would 404 in production.
