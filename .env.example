# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example is not. Never put a real secret here.
# ---------------------------------------------------------------------------

# Database — SQLite. The path is relative to the `prisma/` directory.
# No database server to install; the file is created by `prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Public URL of the app. Must match the address you actually open in the
# browser, or NextAuth's callback and the Socket.IO CORS check will both fail.
NEXTAUTH_URL="http://localhost:3000"

# Signing key for session JWTs. Generate a fresh one — do NOT ship this value.
#
#   npm run gen:secret
#
# In production the server refuses to start if this is missing, shorter than 32
# characters, or still the development value that ships in this project's .env.
NEXTAUTH_SECRET=""

# Require a verified email address before sign-in is allowed.
# Leave "false" until real SMTP delivery is configured — otherwise every new
# account is locked out immediately, because verification links are generated
# but never actually sent anywhere.
REQUIRE_EMAIL_VERIFICATION="false"

# Optional Google OAuth. Leave both blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Where uploaded library files are written. Blank means ./storage.
#
# REQUIRED IN PRODUCTION, pointing at a mounted volume. A container's own disk
# is wiped on every deploy, so uploads written there disappear without any error
# — the material rows survive and their files do not.
# Must stay OUTSIDE ./public, which is served with no auth check.
#   Railway: /data/storage      Render: /var/data/storage
STORAGE_DIR=""

# Where the student portal front-end is served from. Blank is correct almost
# everywhere: the app uses the parent folder when it holds an index.html (the
# development layout) and otherwise the copy at ./portal that `npm run build`
# writes. Set this only to serve the portal from a third location.
PORTAL_DIR=""

# Seed account (used by `npm run prisma:seed`).
# Change the password before seeding, and change it again after first login.
SEED_ADMIN_NAME="COE Administrator"
SEED_ADMIN_USERNAME="@admin"
SEED_ADMIN_EMAIL="admin@au.edu.ph"
SEED_ADMIN_PASSWORD=""
